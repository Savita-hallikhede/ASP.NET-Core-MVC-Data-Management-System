<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="EntityFrameworkCoreMock.Moq" Version="4.0.0" />
    <PackageReference Include="EPPlus" Version="8.6.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Entity">
      <HintPath>..\Entity\bin\Debug\net8.0\Entity.dll</HintPath>
    </Reference>
    <Reference Include="Service">
      <HintPath>..\Service\bin\Debug\net8.0\Service.dll</HintPath>
    </Reference>
    <Reference Include="ServiceContracts">
      <HintPath>..\ServiceContracts\bin\Debug\net8.0\ServiceContracts.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
