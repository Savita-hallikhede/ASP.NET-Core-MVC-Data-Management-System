@using ServiceContracts.DTO
@model List<PersonResponse>
<html>
	<head>
		<title>

		</title>
	</head>
	<body>

		<table>
          <tr>
			  <th>Person ID:</th>
			  <th>Person Name:</th>
			  <th>Person Email:</th>
			  <th>DateOfBirth:</th>
			  <th>Gender:</th>
			  <th>Country:</th>
			  <th>Address:</th>
			  <th>ReceiveNewsLetters:</th>
		  </tr>
		  
		@foreach (PersonResponse data in Model)
		{
            <tr>
				<td>@data.PersonId</td>
				<td>@data.PersonName</td>
				<td>@data.PersonEmail</td>
				<td>@data.DateOfBirth</td>
				<td>@data.Gender</td>
				<td>@data.Country</td>
				<td>@data.CountryId</td>
				<td>@data.Address</td>
				<td>@data.ReceiveNewsLetters</td>
			</tr> 
		}
	</table>
	</body>
</html>